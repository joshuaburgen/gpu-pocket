# Install root-owned, mode 0440 under /etc/sudoers.d/gpu-pocket-gpu1.
# This grants GPU1 only; GPU0 permissions are managed separately.
joshua ALL=(root) NOPASSWD: /usr/bin/systemctl start gpu-pocket-miner@1.service, /usr/bin/systemctl restart gpu-pocket-miner@1.service, /usr/bin/systemctl stop gpu-pocket-miner@1.service
